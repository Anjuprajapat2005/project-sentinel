{
  "buildCommand": "pnpm --filter @sentinel/dashboard build",
  "outputDirectory": "apps/dashboard/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_WS_URL": "@ws-url",
    "MCP_PORT": "3456"
  },
  "builds": [
    {
      "src": "apps/dashboard/**/*",
      "use": "@vercel/next"
    }
  ]
}
